# Copy this file to .env.local and fill in real values. Never commit .env.local

# MongoDB
MONGODB_URI=

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Email (order confirmations, OTP, password reset, enquiry notifications).
# With EMAIL_SERVER_HOST blank, mail is logged to the console instead of sent —
# nothing breaks, it just does not leave the machine.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=

# Optional extra recipient for bulk and customisation enquiries, on top of the
# support and contact addresses set in Admin -> Settings -> Contact.
BULK_ENQUIRY_EMAIL=

# --- ZenBlue additions ---

# Public site URL — used for canonical tags, JSON-LD and links in emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seed script (optional — defaults to admin@zenblue.in / ChangeMe123!)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# WhatsApp Business Cloud API (order + recovery notifications)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta-approved template names, one per event
WHATSAPP_TEMPLATE_ORDER_PLACED=
WHATSAPP_TEMPLATE_ORDER_SHIPPED=
WHATSAPP_TEMPLATE_ABANDONED_CART=

# Transactional SMS via a DLT-registered gateway (MSG91 shape)
SMS_API_KEY=
SMS_SENDER_ID=
# DLT-approved template ids, one per event
SMS_TEMPLATE_ORDER_PLACED=
SMS_TEMPLATE_ORDER_SHIPPED=
SMS_TEMPLATE_OTP_LOGIN=
SMS_TEMPLATE_ABANDONED_CART=

# Courier aggregator
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
DELHIVERY_API_TOKEN=

# Shared secret for the scheduled sweep at /api/cron/abandoned-cart.
# Callers present it as: Authorization: Bearer <value>
CRON_SECRET=

# ERP integration (see /admin/erp). Leave blank to disable it entirely.
ERP_BASE_URL=
ERP_API_KEY=
# HisabKitab sends the raw key in an `apikey` header.
ERP_AUTH_HEADER=apikey
ERP_AUTH_SCHEME=
ERP_TIMEOUT_MS=15000
# Official HisabKitab third-party routes.
ERP_PATH_PING=/cess-rates
ERP_PATH_PRODUCTS=/items
ERP_PATH_STOCK=/items
ERP_PATH_PRICES=/items
ERP_PATH_CUSTOMERS=/ledgers
ERP_PATH_ORDERS=/sale-transactions
ERP_PATH_DISPATCH=/delivery-challan-transactions
ERP_PATH_RETURNS=/sale-return-transactions

# Product pull: new ERP SKUs are created inactive. Set this to one existing
# website category slug when ERP item-group names do not match site categories.
ERP_DEFAULT_CATEGORY_SLUG=

# Required only for Store -> ERP sale invoice creation. Obtain these ids from
# the HisabKitab country/state/city and GST tax master endpoints.
ERP_DEFAULT_COUNTRY_ID=
ERP_DEFAULT_STATE_ID=
ERP_DEFAULT_CITY_ID=
ERP_DEFAULT_GST_TAX_ID=
# Fallbacks used only when the ERP item/customer is missing its own mapping.
ERP_DEFAULT_CUSTOMER_LEDGER_ID=
ERP_DEFAULT_SALES_LEDGER_ID=
ERP_DEFAULT_UNIT_ID=
ERP_SALE_CLASSIFICATION=Intrastate Sales Taxable
